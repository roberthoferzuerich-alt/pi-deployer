# Raspberry Pi 5 - Nginx Configuration Template for Pi Deployer
# Path on Raspberry Pi: /etc/nginx/sites-available/pi-deployer

server {
    listen 8445 ssl;
    listen [::]:8445 ssl;
    server_name rhz.internet-box.ch;
    root /var/www/pi-deployer/public;

    index index.php index.html index.htm;

    # SSL-Zertifikate (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/rhz.internet-box.ch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rhz.internet-box.ch/privkey.pem;

    # 1. Standard Laravel Routing & Assets
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 2. PHP-FPM Verarbeitung (PHP 8.4)
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;

        # Parameter für POST-Requests (Formulare, AJAX & API-Deployments)
        include fastcgi_params;
        fastcgi_param REQUEST_METHOD $request_method;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
    }

    # 3. Sicherheit (versteckte Dateien wie .env und .git blockieren)
    location ~ /\.ht {
        deny all;
    }

    location ~ /\.env {
        deny all;
    }

    location ~ /\.git {
        deny all;
    }
}
